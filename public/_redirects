# Cloudflare Pages Redirect Rules
# SPA routing configuration - serve index.html for all routes except assets

# Cache busting for assets with hashes (these can be cached long-term)
/assets/* 200! js,css,webp,png,jpg,jpeg,gif,svg

# Static files
/public/* 200
/robots.txt 200
/sitemap.xml 200
/*.json 200
/*.xml 200

# SPA routing - all other routes serve index.html
/* /index.html 200
